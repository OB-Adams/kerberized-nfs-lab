# /etc/sssd/sssd.conf on every LDAP/Kerberos client (client, later nfs)
# Holds no secrets since K5: SSSD binds to LDAP with this host's keytab.
# SSSD still checks its permissions: root:root 0600, or root:sssd 0640 when it runs as user sssd.
[sssd]
services = nss, pam, sudo
domains = lab.local

[domain/lab.local]
# Identity from LDAP, authentication and password changes from Kerberos (K4)
id_provider = ldap
auth_provider = krb5
chpass_provider = krb5
access_provider = simple
simple_allow_groups = sysadmins
sudo_provider = ldap

# Kerberos: KDC found through the _kerberos SRV records; logins obtain a TGT
krb5_realm = LAB.LOCAL
krb5_server = _srv_
krb5_kpasswd = ldap.lab.local
# Verify each new TGT against this host's keytab (defeats a fake KDC)
krb5_validate = true
krb5_keytab = /etc/krb5.keytab
krb5_lifetime = 24h
krb5_renewable_lifetime = 7d
krb5_renew_interval = 3600
krb5_store_password_if_offline = true

# LDAP connection for identity lookups: StartTLS required, certificate verified
ldap_uri = ldap://ldap.lab.local
ldap_id_use_start_tls = true
ldap_tls_reqcert = demand
ldap_tls_cacert = /etc/pki/ca-trust/source/anchors/lab-root-ca.crt
# The lab has no IPv6; skip AAAA lookups
lookup_family_order = ipv4_only

# Directory layout (rfc2307bis: groups list members by DN)
ldap_schema = rfc2307bis
ldap_search_base = dc=lab,dc=local
ldap_user_search_base = ou=People,dc=lab,dc=local
ldap_group_search_base = ou=Groups,dc=lab,dc=local
ldap_sudo_search_base = ou=SUDOers,dc=lab,dc=local
ldap_user_gecos = cn

# Lookup identity (K5): SASL/GSSAPI bind as host/client.lab.local, key from the keytab.
# 389-ds maps it to cn=client.lab.local,ou=Hosts (ldif/sasl-map-hosts.ldif).
ldap_sasl_mech = GSSAPI
ldap_sasl_authid = host/client.lab.local@LAB.LOCAL
ldap_krb5_keytab = /etc/krb5.keytab
ldap_krb5_init_creds = true

cache_credentials = true
enumerate = false
