# /etc/sssd/sssd.conf on every LDAP client (client, later nfs)
# Holds the sssd-bind password. Never world-readable:
#   root:sssd 0640 when SSSD runs as user sssd (systemctl cat sssd shows User=sssd)
#   root:root 0600 when SSSD runs as root
[sssd]
services = nss, pam, sudo
domains = lab.local

[domain/lab.local]
# Identity, authentication, password change, authorization
id_provider = ldap
auth_provider = ldap
chpass_provider = ldap
access_provider = simple
simple_allow_groups = sysadmins
sudo_provider = ldap

# Connection: StartTLS required, certificate must verify against the lab CA
ldap_uri = ldap://ldap.lab.local
ldap_id_use_start_tls = true
ldap_tls_reqcert = demand
ldap_tls_cacert = /etc/pki/ca-trust/source/anchors/lab-root-ca.crt
# The lab has no IPv6; skip AAAA lookups
lookup_family_order = ipv4_only

# Directory layout (rfc2307bis: groups list members by DN)
ldap_schema = rfc2307bis
ldap_search_base = dc=lab,dc=local
ldap_user_search_base = ou=People,dc=lab,dc=local
ldap_group_search_base = ou=Groups,dc=lab,dc=local
ldap_sudo_search_base = ou=SUDOers,dc=lab,dc=local
ldap_user_gecos = cn

# Read-only lookup identity
ldap_default_bind_dn = uid=sssd-bind,ou=Services,dc=lab,dc=local
ldap_default_authtok_type = password
ldap_default_authtok = CHANGE_ME

cache_credentials = true
enumerate = false
