; /var/named/lab.local.zone  (root:named, 0640, SELinux type named_zone_t)
$TTL 3600
@       IN SOA  ldap.lab.local. hostmaster.lab.local. (
                2026111201 ; serial (YYYYMMDDnn) - raise on every edit
                3600       ; refresh
                900        ; retry
                604800     ; expire
                300 )      ; negative-cache TTL
        IN NS   ldap.lab.local.

ldap    IN A    192.168.0.210
client  IN A    192.168.0.220
nfs     IN A    192.168.0.230

; Kerberos realm LAB.LOCAL: realm name and service locations (RFC 4120 / MIT)
_kerberos               IN TXT  "LAB.LOCAL"
_kerberos._udp          IN SRV  0 100 88  ldap.lab.local.
_kerberos._tcp          IN SRV  0 100 88  ldap.lab.local.
_kerberos-master._udp   IN SRV  0 100 88  ldap.lab.local.
_kerberos-master._tcp   IN SRV  0 100 88  ldap.lab.local.
_kerberos-adm._tcp      IN SRV  0 100 749 ldap.lab.local.
_kpasswd._udp           IN SRV  0 100 464 ldap.lab.local.
_kpasswd._tcp           IN SRV  0 100 464 ldap.lab.local.
